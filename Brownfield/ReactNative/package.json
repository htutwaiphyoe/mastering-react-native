{
  "name": "ReactNative",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "rock start",
    "lint": "eslint .",
    "test": "jest",
    "ios": "rock run:ios",
    "android": "rock run:android",
    "package:ios": "rock package:ios --scheme ReactNativeReact --configuration Release",
    "package:aar": "rock package:aar --variant Release --module-name reactnativereact",
    "publish-local:aar": "npm run package:aar && rock publish-local:aar --module-name reactnativereact"
  },
  "dependencies": {
    "@callstack/react-native-brownfield": "^2.0.0",
    "react": "19.2.0",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@callstack/repack": "^5.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@rock-js/platform-android": "^0.15.1",
    "@rock-js/platform-ios": "^0.15.1",
    "@rock-js/plugin-brownfield-android": "^0.15.1",
    "@rock-js/plugin-brownfield-ios": "^0.15.1",
    "@rock-js/plugin-repack": "^0.15.1",
    "@rock-js/welcome-screen": "^0.15.1",
    "@rspack/core": "^1.5.0",
    "@swc/helpers": "^0.5.17",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "rock": "^0.15.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=20"
  }
}